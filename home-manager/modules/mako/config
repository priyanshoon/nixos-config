
### Muted night-kitchen theme — matches Waybar ###

# Font
font=Mononoki Nerd Font 10

# Layout
padding=10
margin=10
border-size=2
border-radius=6
anchor=top-right
width=320

# Icons
icons=1
max-icon-size=32

# Default colors
background-color=#111817
text-color=#C5D0CC
border-color=#89A8A7

default-timeout=0

# Low urgency
[urgency=low]
border-color=#52615D
background-color=#1D2928
text-color=#9AABA5

# Normal urgency
[urgency=normal]
border-color=#89A8A7

# Critical urgency
[urgency=critical]
background-color=#2A3836
border-color=#B06F72
text-color=#C5D0CC

